{
  "color": {
    "ground": "#0c1240",
    "ink": "#0a0a1f",
    "paper": "#eceff3",
    "blue": "#5f8dff",
    "red": "#f2706a",
    "yellow": "#f2c94c",
    "violet": "#a995f0",
    "muted": "#4a4d78",
    "mist": "#b9bde0",
    "rule": "#d3d8e0"
  },
  "font": {
    "family": {
      "display": "'Space Grotesk', system-ui, sans-serif",
      "comic": "Bangers, 'Arial Black', Impact, sans-serif",
      "body": "'DM Sans', system-ui, sans-serif"
    },
    "size": {
      "caption2": "11px",
      "caption1": "12px",
      "footnote": "13px",
      "subhead": "15px",
      "body": "17px",
      "title3": "20px",
      "title2": "22px",
      "title1": "28px"
    },
    "fluid": {
      "display2": "clamp(32px,5.5vw,52px)",
      "display1": "clamp(44px,10vw,104px)",
      "hero": "clamp(52px,10vw,144px)"
    }
  },
  "space": {
    "s1": "4px",
    "s2": "8px",
    "s3": "12px",
    "s4": "16px",
    "s5": "20px",
    "s6": "24px",
    "s8": "32px"
  },
  "radius": {
    "group": "12px",
    "card": "16px",
    "hero": "24px",
    "sheet": "28px",
    "toon": "10px"
  },
  "border": {
    "toon": "2px"
  },
  "shadow": {
    "blue": "4px 4px 0 #5f8dff",
    "red": "4px 4px 0 #f2706a",
    "yellow": "4px 4px 0 #f2c94c",
    "violet": "4px 4px 0 #a995f0",
    "lift": "6px 7px 0 var(--toon-shadow, #f2706a)",
    "press": "0 0 0 var(--toon-shadow, #f2706a)"
  },
  "ease": {
    "spring": "cubic-bezier(0.175, 0.885, 0.32, 1.275)",
    "bounce": "cubic-bezier(0.34, 1.8, 0.5, 1)"
  },
  "duration": {
    "fast": "0.2s",
    "normal": "0.3s",
    "slow": "0.5s"
  }
}
