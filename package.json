{
  "name": "toonish-ui",
  "version": "0.2.0",
  "devDependencies": {
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/bun": "^1.4.4",
    "axe-core": "4.10.2",
    "playwright-core": "^1.65.0",
    "style-dictionary": "^5.8.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.8.3"
  },
  "description": "Toonish: an original comic-book UI kit. Design tokens, a Tailwind preset, component CSS and a little behaviour.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://pdlab.dev/ui.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeteDio-Labs/toonish-ui.git"
  },
  "author": "PeteDio Labs",
  "sideEffects": [
    "*.css",
    "./dist/toonish.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preset": {
      "types": "./dist/types/src/preset.d.ts",
      "default": "./dist/preset.js"
    },
    "./markup": {
      "types": "./dist/types/src/markup.d.ts",
      "default": "./dist/markup.js"
    },
    "./toonish.css": "./dist/toonish.css",
    "./toonish.min.css": "./dist/toonish.min.css",
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./tokens.json": "./dist/tokens.json",
    "./toonish.js": "./dist/toonish.js",
    "./fonts/*": "./dist/fonts/*",
    "./src/toonish.css": "./src/toonish.css",
    "./src/components.css": "./src/components.css",
    "./src/fonts.css": "./src/fonts.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "tokens",
    "README.md",
    "docs",
    "CONTRIBUTING.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:browser": "bun run test/browser.ts",
    "check": "bun run typecheck && bun run build && bun test && bun run test:browser"
  },
  "engines": {
    "bun": ">=1.4.4 <1.5.0"
  }
}
